@startuml
!include <C4/C4_Container>

title Спринт 1. MSA-AgroTech. C2. Диаграмма контейнеров

Person(mech, "Механик", "Мониторинг техники")
Person(vet, "Ветеринар", "Получает уведомления о здоровье животных")
Person(agro, "Агроном", "Контролирует процесс выращивания культур")
Person(analit, "Аналитик", "Готовит отчёты для руководителя")
Person(director, "Директор", "Общее управление предприятием")

System_Ext(cameras_1, "Камеры и датчики на ферме 01", "Данные датчиков, видеопоток")

System_Boundary(agent_boundary, "Агент_01 (Локальный контур фермы)") {
    Container(agent_app, "Agent Service", "Go / Python", "Сбор данных, первичная обработка и регистрация инцидентов")
    ContainerDb(agent_db, "Local DB", "SQLite / Redis", "Временное кеширование данных при отсутствии связи (Offline-first)")
}

System_Boundary(central_server_boundary, "Центральный сервер (Облачный/Центральный контур)") {
    Container(api_gateway, "API Gateway", "Nginx / Envoy", "Маршрутизация запросов, аутентификация и балансировка")
    
    Container(telemetry_service, "Telemetry & Machinery Service", "Java / Spring", "Обработка телеметрии и мониторинг состояния техники")
    Container(agro_service, "Agro & Vet Service", "Java / Spring", "Управление процессами выращивания и здоровьем животных")
    Container(sync_service, "Data Sync Service", "Node.js / Go", "Оркестрация процессов синхронизации данных с агентами")
    
    ContainerDb(central_db, "Central Database", "PostgreSQL", "Хранение агрегированных данных, метаданных и настроек")
    ContainerDb(tsdb, "Time-Series DB", "TimescaleDB / InfluxDB", "Хранение сырых метрик и телеметрии с датчиков")
}

System_Ext(notify, "Система уведомлений", "Уведомления (SMS, Push, Email)")
System_Ext(erp, "ERP-система", "Финансы, склад, кадры")
System_Ext(bi, "BI-система", "Подготовка отчетов")


Rel(cameras_1, agent_app, "Отправка сырых данных", "MQTT / HTTP")
Rel_D(agent_app, agent_db, "Кеширование и чтение локальных данных", "SQL / Key-Value")

Rel(mech, agent_app, "Просмотр локального статуса техники", "Web/Mobile")
Rel(vet, agent_app, "Просмотр локального состояния животных", "Web/Mobile")
Rel(agro, agent_app, "Ввод оперативных данных", "Web/Mobile")

Rel_D(agent_app, api_gateway, "Синхронизация данных и инцидентов", "HTTPS / gRPC")

Rel_D(api_gateway, sync_service, "Перенаправление пакетов синхронизации", "gRPC")
Rel_D(api_gateway, telemetry_service, "Запросы пользователей / Агентов по технике", "HTTP/gRPC")
Rel_D(api_gateway, agro_service, "Запросы по культуре и ветеринарии", "HTTP/gRPC")

Rel_U(sync_service, central_db, "Запись бизнес-сущностей", "SQL")
Rel_U(sync_service, tsdb, "Запись временных рядов (телеметрия)", "SQL/Line Protocol")
Rel_D(telemetry_service, tsdb, "Чтение метрик", "SQL")
Rel_D(agro_service, central_db, "Чтение/Запись данных", "SQL")

Rel_R(telemetry_service, notify, "Триггер уведомления при поломке", "REST API")
Rel_R(agro_service, notify, "Триггер уведомления о здоровье/поливе", "REST API")
Rel_D(agro_service, erp, "Выгрузка данных по списаниям/урожаю", "REST API")

Rel(notify, director, "Отправка уведомлений", "SMS, Push, Email")
Rel(notify, analit, "Отправка уведомлений", "SMS, Push, Email")
Rel(director, erp, "Управление предприятием", "GUI")
Rel(analit, bi, "Построение BI-моделей", "SQL/API")
Rel_L(bi, central_db, "Сбор агрегированных данных для аналитики", "SQL (Read-Replica)")

@enduml
